# Copy this to .env and fill in your keys (never commit the real .env)
ALPHA_VANTAGE_API_KEY=
APITUBE_API_KEY=
# Free, registered key from https://fred.stlouisfed.org/docs/api/api_key.html
# — used only by scripts/archive/compare_fred_lookahead.py (read-only, not wired
# into scoring or the live dashboard). See
# docs/calendar-lookahead-source-research-2026-08-15.md.
FRED_API_KEY=
# ACT official-actuals poller: BLS public API v2 key, https://data.bls.gov/registrationEngine/ (500 requests/day)
BLS_API_KEY=
# BEA API UserID, https://apps.bea.gov/API/signup/
BEA_API_KEY=
# Census API key, https://api.census.gov/data/key_signup.html (activate it from the e-mail first)
CENSUS_API_KEY=
# EIA API v2 key, https://www.eia.gov/opendata/register.php
EIA_API_KEY=
